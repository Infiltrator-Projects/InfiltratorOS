#!/bin/sh
# InfiltratorOS installation entry point. The embedded native workers are
# installation-only; they are never installed in /System/Commands.
set -eu

STATUS_ROOT=/Temporary/InfiltratorOS
# All InfiltratorOS-owned installation files stay under the native /Temporary root.
BUNDLE_SHA256='@NATIVE_RUNTIME_SHA256@'

migrate_legacy_calendar_pin() (
    pin=$1
    [ -f "$pin" ] && [ ! -L "$pin" ] || exit 0
    original=$(sha256sum -- "$pin") || exit 1
    # Earlier repository setup forced a downgrade from Ubuntu's namesake.
    # Replace only that complete legacy rule, including on existing machines.
    if ! awk '
        /^[[:space:]]*(#.*)?$/ { next }
        { sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, ""); gsub(/[[:blank:]]+/, " "); line[++count] = $0 }
        END { exit !(count == 3 && line[1] == "Package: calendar" &&
            line[2] == "Pin: origin infiltrator-projects.github.io" &&
            line[3] == "Pin-Priority: 1001") }
    ' "$pin"; then
        exit 0
    fi
    replacement=$(mktemp "${pin%/*}/.infiltrator-calendar.XXXXXXXX") || exit 1
    trap 'rm -f -- "$replacement"' EXIT HUP INT TERM
    cat > "$replacement" <<'CALENDAR_POLICY' || exit 1
# Keep the CPU-native Calendar as the candidate and prefer Infiltrator builds.
Package: calendar
Pin: version /.*[+]nativepgo.*/
Pin-Priority: 1000

Package: calendar
Pin: release o=Infiltrator
Pin-Priority: 999
CALENDAR_POLICY
    chmod 0644 "$replacement" || exit 1
    [ ! -L "$pin" ] && [ "$(sha256sum -- "$pin")" = "$original" ] || exit 1
    mv -fT -- "$replacement" "$pin" || exit 1
    printf '%s\n' 'Updated the legacy Calendar APT preference to preserve the native build.'
)

unpack_native_workers() {
    stage=$1
    bundle="$stage/runtime.tar.gz"
    awk '
        /^__INFILTRATOROS_NATIVE_BUNDLE_BEGIN__$/ { within=1; next }
        /^__INFILTRATOROS_NATIVE_BUNDLE_END__$/ { exit }
        within { print }
    ' "$0" | base64 -d > "$bundle" || return 1
    printf '%s  %s\n' "$BUNDLE_SHA256" "$bundle" | sha256sum -c - >/dev/null || return 1
    tar -xzf "$bundle" -C "$stage" --no-same-owner --no-same-permissions || return 1
    rm -f -- "$bundle" || return 1
    for product in system-monitor calculator calendar files defragmenter temporal-resources filesystem-resources; do
        test -x "$stage/start-$product-install" || return 1
        test -x "$stage/install-$product" || return 1
        test -x "$stage/$product-progress" || return 1
    done
    test -x "$stage/prepare-native-releases" || return 1
    test -x "$stage/orchestrate-native-install" || return 1
    test -x "$stage/install-boot-option" || return 1
    for inventory in temporal-resources.json filesystem-resources.json filesystem-additional.json; do
        test -s "$stage/$inventory" || return 1
    done
}

configure_boot() (
    boot_stage=$1
    boot_log="$boot_stage/status/boot-install.log"
    mkdir -p "$boot_stage/status"
    # APT has configured the independent BOOT dependency. This step makes
    # no nested APT calls and can run while an earlier native build is active.
    boot_result=0
    "$boot_stage/install-boot-option" > "$boot_log" 2>&1 || boot_result=$?
    case "$boot_result" in
        0)
            tail -n 1 "$boot_log"
            printf '%s\n' state=complete progress=100 'stage=Available in the UEFI boot menu' detail= \
                > "$boot_stage/status/boot-install.status"
            ;;
        77) tail -n 1 "$boot_log" ;;
        *)
            echo "Could not add or update BOOT. See $boot_log" >&2
            printf '%s\n' state=failed progress=100 'stage=BOOT upgrade failed' 'detail=See boot-install.log.' \
                > "$boot_stage/status/boot-install.status"
            ;;
    esac
)

# CI inspection never mutates the installed system or launches applications.
if [ "${1:-}" = "--verify-installer-bundle" ]; then
    inspect=$(mktemp -d)
    trap 'rm -rf -- "$inspect"' EXIT HUP INT TERM
    if ! unpack_native_workers "$inspect"; then
        echo 'Invalid embedded InfiltratorOS native installer bundle.' >&2
        exit 1
    fi
    test "$(find "$inspect" -maxdepth 1 -type f | wc -l)" -eq 27
    exit 0
fi

# Package configuration and reinstall share one canonical installation path.
if [ "${1:-}" != configure ]; then
    exit 0
fi

if ! migrate_legacy_calendar_pin /etc/apt/preferences.d/infiltrator-calendar.pref; then
    echo 'Could not migrate the legacy Calendar APT preference.' >&2
fi

mkdir -p "$STATUS_ROOT"
chmod 0755 "$STATUS_ROOT"
# Hold a run-wide lock across the detached monitor lifetime. A reinstall
# during active native compilation must not spawn duplicate jobs.
if ! command -v flock >/dev/null 2>&1; then
    echo 'InfiltratorOS requires util-linux flock to coordinate native setup.' >&2
    exit 1
fi
exec 9>"$STATUS_ROOT/provision.lock"
if ! flock -n 9; then
    echo 'InfiltratorOS native provisioning is already active; not launching a duplicate run.'
    (
        boot_stage=$(mktemp -d "$STATUS_ROOT/boot-upgrade.XXXXXXXX")
        trap 'rm -rf -- "$boot_stage"' 0
        if ! unpack_native_workers "$boot_stage"; then
            echo 'InfiltratorOS could not verify its BOOT installation worker.' >&2
            exit 1
        fi
        configure_boot "$boot_stage"
        chmod 0600 "$boot_stage/status/boot-install.log"
        mv -fT -- "$boot_stage/status/boot-install.log" "$STATUS_ROOT/last-boot-upgrade.log"
        printf '%s\n' "BOOT diagnostics: $STATUS_ROOT/last-boot-upgrade.log"
    )
    exit 0
fi
TMPDIR="$STATUS_ROOT"
export TMPDIR

# Assign a fresh run identity before any fallible setup; stale success from a
# previous installation must never outlive a failed new bootstrap.
stage=$(mktemp -d "$STATUS_ROOT/native-worker.XXXXXXXX")
chmod 0755 "$stage"
publish_summary() {
    summary_state=$1
    summary_tmp="$STATUS_ROOT/.last-provision.$.tmp"
    printf 'state=%s\nstage=%s\n' "$summary_state" "$stage" > "$summary_tmp"
    chmod 0644 "$summary_tmp"
    mv -f -- "$summary_tmp" "$STATUS_ROOT/last-provision.status"
}
bootstrap_on_exit() {
    result=$1
    trap - 0
    if [ "$result" -ne 0 ]; then
        printf '%s\n' 'Native bootstrap failed; see package-manager output and retained stage.' > "$stage/FAILED" || :
        publish_summary failed || :
    fi
    exit "$result"
}
trap 'bootstrap_on_exit $?' 0
publish_summary running
rm -f -- "$STATUS_ROOT/filesystems-pending.list"

/System/Commands/InfiltratorOS/ensure-native-fonts
/System/Commands/InfiltratorOS/ensure-native-icons

# Progress windows run as the graphical desktop user and need directory access.
if ! unpack_native_workers "$stage"; then
    echo 'InfiltratorOS could not verify its native installation workers.' >&2
    exit 1
fi

if ! INFILTRATOROS_PROGRESS_MODE=aggregate INFILTRATOROS_INSTALL_RUNTIME="$stage" \
        "$stage/start-system-monitor-install" --show-progress; then
    echo 'Could not start InfiltratorOS graphical progress.' >&2
fi
/System/Commands/InfiltratorOS/select-theme configure

# Every run owns its own status and log directory beneath its temporary
# worker stage. No run may remove shared /Temporary/InfiltratorOS or files
# belonging to a previous or concurrent installation.
configure_boot "$stage"
# One dispatcher owns enumeration, release preparation and component launches.
# Individual component workers remain responsible for their own installations.
if ! INFILTRATOROS_INSTALL_RUNTIME="$stage" "$stage/orchestrate-native-install" "$stage"; then
    echo 'InfiltratorOS native installation dispatch failed.' >&2
    exit 1
fi

# The monitor must only inspect statuses for this exact installation. A
# subsequent package upgrade has another stage and cannot overwrite these.
# The subshell inherits FD 9 and holds provision.lock until all launched jobs
# reach a terminal state. A diagnostic deadline must NEVER unlock an active run:
# detached workers close inherited descriptors and cannot protect this lock.
# All statuses must be terminal before this run's binaries can be removed.
(
    # The background monitor, not the parent's bootstrap handler, now owns
    # the final status, with its independent lock and run directory.
    trap - 0
    trap '' HUP INT TERM
    status_root="$stage/status"
    elapsed=0
    while :; do
        # The GUI and monitor share the manifest and status parsers.
        outcome=$("$stage/system-monitor-progress" --run-status "$status_root") || outcome=running
        case "$outcome" in
            complete)
                # Keep diagnostic logs, including build timings, after success.
                # Do not keep temporary source trees or executed native RUNs.
                archive_tmp="$STATUS_ROOT/.last-provision-logs.$.tar.gz"
                if (umask 077
                    cd "$stage"
                    tar -czf "$archive_tmp" status selected.list \
                        native-release-preparation.log \
                        optional-filesystem-discovery.log \
                        filesystems-optional.list filesystems-pending.list
                ); then
                    chmod 0600 "$archive_tmp"
                    mv -f -- "$archive_tmp" "$STATUS_ROOT/last-provision-logs.tar.gz"
                else
                    rm -f -- "$archive_tmp"
                fi
                publish_summary complete
                rm -rf -- "$stage"
                exit 0
                ;;
            failed)
                printf '%s\n' 'Installation failed; this run retains its logs and statuses.' > "$stage/FAILED"
                publish_summary failed
                exit 0
                ;;
        esac
        # A 24-hour deadline is diagnostic, not evidence of worker exit.
        # Never release FD 9 while a worker status is still non-terminal.
        if [ "$elapsed" -ge 86400 ] && [ ! -f "$stage/LONG_RUNNING" ]; then
            printf '%s\n' 'Installation exceeded 24 hours; retaining the provisioning lock until every worker reaches a terminal state. Investigate retained status and log files.' > "$stage/LONG_RUNNING"
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
) </dev/null >/dev/null 2>&1 &

# Disable the bootstrap handler only after spawning the terminal monitor.
trap - 0
exit 0

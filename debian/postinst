#!/bin/sh
# InfiltratorOS installation entry point. The embedded native workers are
# installation-only; they are never installed in /System/Commands.
set -eu

STATUS_ROOT=/run/infiltratoros
# /run is noexec on many Debian/Ubuntu boot configurations. Native ELF
# installer workers must be staged on an executable filesystem instead.
WORKER_PARENT=/var/lib
BUNDLE_SHA256='@NATIVE_RUNTIME_SHA256@'

unpack_native_workers() {
    stage=$1
    bundle="$stage/runtime.tar.gz"
    awk '
        /^__INFILTRATOROS_NATIVE_BUNDLE_BEGIN__$/ { within=1; next }
        /^__INFILTRATOROS_NATIVE_BUNDLE_END__$/ { exit }
        within { print }
    ' "$0" | base64 -d > "$bundle" || return 1
    printf '%s  %s\n' "$BUNDLE_SHA256" "$bundle" | sha256sum -c - >/dev/null || return 1
    tar -xzf "$bundle" -C "$stage" --no-same-owner --no-same-permissions || return 1
    rm -f -- "$bundle" || return 1
    for product in system-monitor calculator files defragmenter; do
        test -x "$stage/start-$product-install" || return 1
        test -x "$stage/install-$product" || return 1
        test -x "$stage/$product-progress" || return 1
    done
}

# CI inspection never mutates the installed system or launches applications.
if [ "${1:-}" = "--verify-installer-bundle" ]; then
    inspect=$(mktemp -d)
    trap 'rm -rf -- "$inspect"' EXIT HUP INT TERM
    if ! unpack_native_workers "$inspect"; then
        echo 'Invalid embedded InfiltratorOS native installer bundle.' >&2
        exit 1
    fi
    test "$(find "$inspect" -maxdepth 1 -type f | wc -l)" -eq 12
    exit 0
fi

# Package configuration and reinstall share one canonical installation path.
if [ "${1:-}" != configure ]; then
    exit 0
fi

/System/Commands/InfiltratorOS/ensure-native-fonts
/System/Commands/InfiltratorOS/ensure-native-icons
/System/Commands/InfiltratorOS/select-theme configure

mkdir -p "$STATUS_ROOT"
chmod 0755 "$STATUS_ROOT"
stage=$(mktemp -d "$WORKER_PARENT/infiltratoros-native-worker.XXXXXXXX")
# Progress windows run as the graphical desktop user and need directory access.
chmod 0755 "$stage"
if ! unpack_native_workers "$stage"; then
    rm -rf -- "$stage"
    echo 'InfiltratorOS could not verify its native installation workers.' >&2
    exit 1
fi

# The launcher owns detached worker lifetime. Each worker acquires the shared
# native installation lock and downloads only its own product's GitHub .run.
for product in system-monitor calculator files defragmenter; do
    if ! INFILTRATOROS_INSTALL_RUNTIME="$stage" "$stage/start-$product-install"; then
        echo "Failed to launch $product installer; see /run/infiltratoros status." >&2
    fi
done

# Clean the installation-only executables once all four builds have finished,
# including when a build fails. Logs and status stay available for diagnostics.
# Never execute installer binaries from /run (which may be noexec).
# Ordinary completion, failures and timeout remove the ephemeral executable
# directory; status files and logs remain in their existing locations.
(
    trap '' HUP INT TERM
    elapsed=0
    while [ "$elapsed" -lt 86400 ]; do
        finished=yes
        for product in system-monitor calculator files defragmenter; do
            status="$STATUS_ROOT/$product-install.status"
            if [ ! -f "$status" ] || ! grep -Eq '^state=(complete|failed)$' "$status"; then
                finished=no
                break
            fi
        done
        if [ "$finished" = yes ]; then
            # Let late-running progress windows load their executable.
            sleep 20
            finished=yes
            for product in system-monitor calculator files defragmenter; do
                status="$STATUS_ROOT/$product-install.status"
                if [ ! -f "$status" ] || ! grep -Eq '^state=(complete|failed)$' "$status"; then
                    finished=no
                    break
                fi
            done
            if [ "$finished" = yes ]; then
                rm -rf -- "$stage"
                exit 0
            fi
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
    rm -rf -- "$stage"
) </dev/null >/dev/null 2>&1 &

exit 0

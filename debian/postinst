#!/bin/sh
# InfiltratorOS installation entry point. The embedded native workers are
# installation-only; they are never installed in /System/Commands.
set -eu

STATUS_ROOT=/Temporary/InfiltratorOS
# All InfiltratorOS-owned installation files stay under the native /Temporary root.
BUNDLE_SHA256='@NATIVE_RUNTIME_SHA256@'

unpack_native_workers() {
    stage=$1
    bundle="$stage/runtime.tar.gz"
    awk '
        /^__INFILTRATOROS_NATIVE_BUNDLE_BEGIN__$/ { within=1; next }
        /^__INFILTRATOROS_NATIVE_BUNDLE_END__$/ { exit }
        within { print }
    ' "$0" | base64 -d > "$bundle" || return 1
    printf '%s  %s\n' "$BUNDLE_SHA256" "$bundle" | sha256sum -c - >/dev/null || return 1
    tar -xzf "$bundle" -C "$stage" --no-same-owner --no-same-permissions || return 1
    rm -f -- "$bundle" || return 1
    for product in system-monitor calculator files defragmenter temporal-resources filesystem-resources; do
        test -x "$stage/start-$product-install" || return 1
        test -x "$stage/install-$product" || return 1
        test -x "$stage/$product-progress" || return 1
    done
    test -x "$stage/prepare-native-releases" || return 1
}

# CI inspection never mutates the installed system or launches applications.
if [ "${1:-}" = "--verify-installer-bundle" ]; then
    inspect=$(mktemp -d)
    trap 'rm -rf -- "$inspect"' EXIT HUP INT TERM
    if ! unpack_native_workers "$inspect"; then
        echo 'Invalid embedded InfiltratorOS native installer bundle.' >&2
        exit 1
    fi
    test "$(find "$inspect" -maxdepth 1 -type f | wc -l)" -eq 19
    exit 0
fi

# Package configuration and reinstall share one canonical installation path.
if [ "${1:-}" != configure ]; then
    exit 0
fi

mkdir -p "$STATUS_ROOT"
chmod 0755 "$STATUS_ROOT"
# Hold a run-wide lock across the detached monitor lifetime. A reinstall
# during active native compilation must not spawn duplicate jobs.
if ! command -v flock >/dev/null 2>&1; then
    echo 'InfiltratorOS requires util-linux flock to coordinate native setup.' >&2
    exit 1
fi
exec 9>"$STATUS_ROOT/provision.lock"
if ! flock -n 9; then
    echo 'InfiltratorOS native provisioning is already active; not launching a duplicate run.'
    exit 0
fi
TMPDIR="$STATUS_ROOT"
export TMPDIR

# Assign a fresh run identity before any fallible setup; stale success from a
# previous installation must never outlive a failed new bootstrap.
stage=$(mktemp -d "$STATUS_ROOT/native-worker.XXXXXXXX")
chmod 0755 "$stage"
publish_summary() {
    summary_state=$1
    summary_tmp="$STATUS_ROOT/.last-provision.$.tmp"
    printf 'state=%s\nstage=%s\n' "$summary_state" "$stage" > "$summary_tmp"
    chmod 0644 "$summary_tmp"
    mv -f -- "$summary_tmp" "$STATUS_ROOT/last-provision.status"
}
bootstrap_on_exit() {
    result=$1
    trap - 0
    if [ "$result" -ne 0 ]; then
        printf '%s\n' 'Native bootstrap failed; see package-manager output and retained stage.' > "$stage/FAILED" || :
        publish_summary failed || :
    fi
    exit "$result"
}
trap 'bootstrap_on_exit $?' 0
publish_summary running
rm -f -- "$STATUS_ROOT/filesystems-pending.list"

/System/Commands/InfiltratorOS/ensure-native-fonts
/System/Commands/InfiltratorOS/ensure-native-icons

# Progress windows run as the graphical desktop user and need directory access.
if ! unpack_native_workers "$stage"; then
    echo 'InfiltratorOS could not verify its native installation workers.' >&2
    exit 1
fi

if ! INFILTRATOROS_PROGRESS_MODE=aggregate INFILTRATOROS_INSTALL_RUNTIME="$stage" \
        "$stage/start-system-monitor-install" --show-progress; then
    echo 'Could not start InfiltratorOS graphical progress.' >&2
fi
/System/Commands/InfiltratorOS/select-theme configure

# Every run owns its own status and log directory beneath its temporary
# worker stage. No run may remove shared /Temporary/InfiltratorOS or files
# belonging to a previous or concurrent installation.
mkdir -p "$stage/status"
if ! "$stage/install-temporal-resources" --list > "$stage/providers.list"; then
    echo 'Cannot enumerate the signed calendar and clock catalogue.' >&2
    exit 1
fi
if [ "$(wc -l < "$stage/providers.list")" -ne 54 ]; then
    echo 'The bundled native worker did not list all 54 providers.' >&2
    exit 1
fi

if ! "$stage/install-filesystem-resources" --list > "$stage/filesystems.list"; then
    echo 'Cannot enumerate independent FAT12/FAT16/FAT32/OFS/exFAT installers.' >&2
    exit 1
fi
if [ "$(wc -l < "$stage/filesystems.list")" -ne 5 ]; then
    echo 'Expected precisely five independent filesystem installers.' >&2
    exit 1
fi

# Fetch one 63-component release snapshot over authenticated HTTPS and
# provide independent workers with locally validated release metadata.
# Never issue 63 separate REST API lookups during managed installation.
if ! "$stage/prepare-native-releases" "$stage/release-json" "$stage/providers.list" "$stage/filesystems.list" \
        > "$stage/native-release-preparation.log" 2>&1; then
    cat "$stage/native-release-preparation.log" >&2
    echo 'Native release metadata preparation failed; no workers were launched.' >&2
    exit 1
fi
export INFILTRATOROS_RELEASE_DIR="$stage/release-json"
# The five published filesystem providers remain in the verified central
# release snapshot. Probe the remaining eighteen independently and only admit
# complete published native RUN/DEB/SO releases. CI artifacts are not releases.
if ! "$stage/install-filesystem-resources" --discover-additional "$stage/release-json" \
        > "$stage/optional-filesystem-discovery.log" 2>&1; then
    printf '%s\n' 'Additional filesystem release discovery failed; the five established drivers remain enabled.' \
        >> "$stage/optional-filesystem-discovery.log"
    : > "$stage/filesystems-optional.list"
    "$stage/install-filesystem-resources" --list-all |
        grep -Fvx -f "$stage/filesystems.list" > "$stage/filesystems-pending.list" || :
fi
test -f "$stage/filesystems-optional.list"
test -f "$stage/filesystems-pending.list"
if [ "$(wc -l < "$stage/filesystems-optional.list")" -gt 18 ]; then
    echo 'Refusing an oversized additional filesystem list.' >&2
    exit 1
fi
if [ -s "$stage/filesystems-pending.list" ]; then
    echo 'Some independent filesystem modules await qualified native installer releases.'
    pending_tmp="$stage/filesystems-pending.summary"
    cp -- "$stage/filesystems-pending.list" "$pending_tmp"
    chmod 0644 "$pending_tmp"
    mv -f -- "$pending_tmp" "$STATUS_ROOT/filesystems-pending.list"
fi

# A successful Debian package configuration starts provisioning, not
# confirmation that its detached workers finished.
record_launch_failure() {
    printf 'state=failed\nprogress=100\nstage=Native installer could not start\ndetail=See the run logs.\n' \
        > "$stage/status/$1-install.status"
}

# Four applications, 54 calendar/clock providers and all eligible filesystems.
# Each invocation reports to the one aggregate window and verifies its own .run.
for product in system-monitor calculator files defragmenter; do
    if ! INFILTRATOROS_PROGRESS_MODE=none INFILTRATOROS_INSTALL_RUNTIME="$stage" "$stage/start-$product-install"; then
        echo "Failed to launch $product installer; see $stage/status." >&2
        record_launch_failure "$product"
    fi
done
while IFS= read -r provider; do
    if ! INFILTRATOROS_PROGRESS_MODE=none INFILTRATOROS_INSTALL_RUNTIME="$stage" "$stage/start-temporal-resources-install" "$provider"; then
        echo "Failed to launch $provider installer; see $stage/status." >&2
        record_launch_failure "$provider"
    fi
done < "$stage/providers.list"
while IFS= read -r filesystem; do
    if ! INFILTRATOROS_PROGRESS_MODE=none INFILTRATOROS_INSTALL_RUNTIME="$stage" "$stage/start-filesystem-resources-install" "$filesystem"; then
        echo "Failed to launch $filesystem installer; see $stage/status." >&2
        record_launch_failure "$filesystem"
    fi
done < "$stage/filesystems.list"
while IFS= read -r filesystem; do
    if ! INFILTRATOROS_PROGRESS_MODE=none INFILTRATOROS_INSTALL_RUNTIME="$stage" "$stage/start-filesystem-resources-install" "$filesystem"; then
        echo "Failed to launch $filesystem installer; see $stage/status." >&2
        record_launch_failure "$filesystem"
    fi
done < "$stage/filesystems-optional.list"

# The monitor must only inspect statuses for this exact installation. A
# subsequent package upgrade has another stage and cannot overwrite these.
# The subshell inherits FD 9 and holds provision.lock until all launched jobs
# reach a terminal state (or the existing 24-hour diagnostic timeout). This
# prevents a second apt reinstall from launching a duplicate native run.
# All statuses are terminal before this run's binaries can be removed.
(
    # The background monitor, not the parent's bootstrap handler, now owns
    # the final status, with its independent lock and run directory.
    trap - 0
    trap '' HUP INT TERM
    status_root="$stage/status"
    elapsed=0
    while [ "$elapsed" -lt 86400 ]; do
        # The GUI and monitor share the manifest and status parsers.
        outcome=$("$stage/system-monitor-progress" --run-status "$status_root") || outcome=running
        case "$outcome" in
            complete)
                publish_summary complete
                rm -rf -- "$stage"
                exit 0
                ;;
            failed)
                printf '%s\n' 'Installation failed; this run retains its logs and statuses.' > "$stage/FAILED"
                publish_summary failed
                exit 0
                ;;
        esac
        sleep 5
        elapsed=$((elapsed + 5))
    done
    printf '%s\n' 'Installation monitor timed out; worker files and diagnostics retained.' > "$stage/TIMEOUT"
    publish_summary timeout
) </dev/null >/dev/null 2>&1 &

# Disable the bootstrap handler only after spawning the terminal monitor.
trap - 0
exit 0

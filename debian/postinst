#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# InfiltratorOS installation entry point. The embedded native workers are
# installation-only; they are never installed in /System/Commands.
set -eu

STATUS_ROOT=/Temporary/InfiltratorOS
# All InfiltratorOS-owned installation files stay under the native /Temporary root.
BUNDLE_SHA256='@NATIVE_RUNTIME_SHA256@'
VERSION='@VERSION@'
# @SUPERVISOR_RECOVERY_FUNCTIONS@

migrate_legacy_calendar_pin() (
    pin=$1
    [ -f "$pin" ] && [ ! -L "$pin" ] || exit 0
    original=$(sha256sum -- "$pin") || exit 1
    # Earlier repository setup forced a downgrade from Ubuntu's namesake.
    # Replace only that complete legacy rule, including on existing machines.
    if ! awk '
        /^[[:space:]]*(#.*)?$/ { next }
        { sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, ""); gsub(/[[:blank:]]+/, " "); line[++count] = $0 }
        END { exit !(count == 3 && line[1] == "Package: calendar" &&
            line[2] == "Pin: origin infiltrator-projects.github.io" &&
            line[3] == "Pin-Priority: 1001") }
    ' "$pin"; then
        exit 0
    fi
    replacement=$(mktemp "${pin%/*}/.infiltrator-calendar.XXXXXXXX") || exit 1
    trap 'rm -f -- "$replacement"' EXIT HUP INT TERM
    cat > "$replacement" <<'CALENDAR_POLICY' || exit 1
# Keep the CPU-native Calendar as the candidate and prefer Infiltrator builds.
Package: calendar
Pin: version /.*[+]nativepgo.*/
Pin-Priority: 1000

Package: calendar
Pin: release o=Infiltrator
Pin-Priority: 999
CALENDAR_POLICY
    chmod 0644 "$replacement" || exit 1
    [ ! -L "$pin" ] && [ "$(sha256sum -- "$pin")" = "$original" ] || exit 1
    mv -fT -- "$replacement" "$pin" || exit 1
    printf '%s\n' 'Updated the legacy Calendar APT preference to preserve the native build.'
)

unpack_native_workers() {
    stage=$1
    bundle="$stage/runtime.tar.gz"
    awk '
        /^__INFILTRATOROS_NATIVE_BUNDLE_BEGIN__$/ { within=1; next }
        /^__INFILTRATOROS_NATIVE_BUNDLE_END__$/ { exit }
        within { print }
    ' "$0" | base64 -d > "$bundle" || return 1
    printf '%s  %s\n' "$BUNDLE_SHA256" "$bundle" | sha256sum -c - >/dev/null || return 1
    tar -xzf "$bundle" -C "$stage" --no-same-owner --no-same-permissions || return 1
    rm -f -- "$bundle" || return 1
    for product in system-monitor calculator calendar files defragmenter boot temporal-resources filesystem-resources; do
        test -x "$stage/start-$product-install" || return 1
        test -x "$stage/install-$product" || return 1
        test -x "$stage/$product-progress" || return 1
    done
    test -x "$stage/prepare-native-releases" || return 1
    test -x "$stage/orchestrate-native-install" || return 1
    for inventory in temporal-resources.json filesystem-resources.json filesystem-additional.json; do
        test -s "$stage/$inventory" || return 1
    done
}

# CI inspection never mutates the installed system or launches applications.
if [ "${1:-}" = "--verify-installer-bundle" ]; then
    inspect=$(mktemp -d)
    trap 'rm -rf -- "$inspect"' EXIT HUP INT TERM
    if ! unpack_native_workers "$inspect"; then
        echo 'Invalid embedded InfiltratorOS native installer bundle.' >&2
        exit 1
    fi
    test "$(find "$inspect" -maxdepth 1 -type f | wc -l)" -eq 29
    exit 0
fi

# Package configuration and reinstall share one canonical installation path.
if [ "${1:-}" != configure ]; then
    exit 0
fi

if ! migrate_legacy_calendar_pin /etc/apt/preferences.d/infiltrator-calendar.pref; then
    echo 'Could not migrate the legacy Calendar APT preference.' >&2
fi

[ ! -L /Temporary ] && [ ! -L "$STATUS_ROOT" ] || exit 1
mkdir -p "$STATUS_ROOT"
for directory in /Temporary "$STATUS_ROOT"; do
    [ "$(find "$directory" -maxdepth 0 -type d -uid 0 ! -perm /022 -print)" = "$directory" ] || exit 1
done
chmod 0755 "$STATUS_ROOT"
[ ! -L "$STATUS_ROOT/provision.lock" ] || exit 1
# Hold a run-wide lock across the detached monitor lifetime. A reinstall
# during active native compilation must not spawn duplicate jobs.
if ! command -v flock >/dev/null 2>&1; then
    echo 'InfiltratorOS requires util-linux flock to coordinate native setup.' >&2
    exit 1
fi
exec 9>"$STATUS_ROOT/provision.lock"
if ! flock -n 9; then
    echo 'InfiltratorOS provisioning is active; scheduling the upgraded installer after it finishes.'
    exec 8>"$STATUS_ROOT/provision-pending.lock"
    if flock -n 8; then
        (
            flock 9
            flock -u 9
            flock -u 8
            exec /bin/sh "$0" configure
        ) </dev/null >>"$STATUS_ROOT/deferred-provision.log" 2>&1 &
    fi
    exit 0
fi
recover_abandoned_supervisor "$STATUS_ROOT"
TMPDIR="$STATUS_ROOT"
export TMPDIR

# Assign a fresh run identity before any fallible setup; stale success from a
# previous installation must never outlive a failed new bootstrap.
# Reuse the pre-unpack run only when its identity belongs to this package
# version and to a root-owned, non-symlink stage directly under STATUS_ROOT.
# Configuration retries and overlapping upgrades can legitimately lack it.
pending="$STATUS_ROOT/preinstall-$VERSION.pending"
stage=
if [ -f "$pending" ] && [ ! -L "$pending" ]; then
    candidate=$(cat "$pending")
    case "$candidate" in
        "$STATUS_ROOT"/native-worker.*)
            if [ "${candidate%/*}" = "$STATUS_ROOT" ] &&
               [ -d "$candidate" ] && [ ! -L "$candidate" ] &&
               [ "$(stat -c '%u:%a' "$candidate")" = 0:755 ] &&
               [ "$(cat "$candidate/bootstrap-version" 2>/dev/null || :)" = "$VERSION" ] &&
               [ ! -e "$candidate/early-failed" ]; then
                stage=$candidate
            fi ;;
    esac
    rm -f -- "$pending"
fi
if [ -z "$stage" ]; then
    stage=$(mktemp -d "$STATUS_ROOT/native-worker.XXXXXXXX")
    chmod 0755 "$stage"
else
    # dpkg has successfully unpacked its full, package-owned font payload.
    # A configuration failure does not roll back unpacked package files.
    rm -rf -- "$stage/font-rollback" "$stage/bootstrap-fonts"
fi
publish_summary() {
    summary_state=$1
    summary_tmp="$STATUS_ROOT/.last-provision.$$.tmp"
    printf 'state=%s\nstage=%s\n' "$summary_state" "$stage" > "$summary_tmp"
    if [ "$summary_state" = complete ] && [ -f "$stage/selected.list" ]; then
        printf 'total=%s\n' "$(wc -l < "$stage/selected.list" | tr -d '[:space:]')" >> "$summary_tmp"
    fi
    chmod 0644 "$summary_tmp"
    mv -f -- "$summary_tmp" "$STATUS_ROOT/last-provision.status"
}
bootstrap_on_exit() {
    result=$1
    trap - 0
    if [ "$result" -ne 0 ]; then
        printf '%s\n' 'Native bootstrap failed; see package-manager output and retained stage.' > "$stage/FAILED" || :
        publish_summary failed || :
    fi
    exit "$result"
}
trap 'bootstrap_on_exit $?' 0
publish_summary running
rm -f -- "$STATUS_ROOT/filesystems-pending.list"

# Publish real preparation activity to the per-run GUI. Each phase advances
# only after its predecessor has succeeded; atomic replacement avoids torn reads.
publish_phase() {
    printf '%s\n' "$1" > "$stage/.phase.$$"
    chmod 0644 "$stage/.phase.$$"
    mv -f -- "$stage/.phase.$$" "$stage/phase"
}

# The preinst GUI may still be executing its bootstrap binary. Unlink those
# two verified temporary names before extracting the full sealed runtime;
# Linux retains the mapped executable without a second window or ETXTBSY.
mkdir -p "$stage/status"
rm -f -- "$stage/start-system-monitor-install" "$stage/system-monitor-progress"
if ! unpack_native_workers "$stage"; then
    echo 'InfiltratorOS could not verify its native installation workers.' >&2
    exit 1
fi

publish_phase fonts
if [ ! -f "$stage/early-ui-started" ]; then
    result=0
    INFILTRATOROS_PROGRESS_MODE=aggregate INFILTRATOROS_INSTALL_RUNTIME="$stage" \
        "$stage/start-system-monitor-install" --show-progress || result=$?
    [ "$result" -eq 0 ] || [ "$result" -eq 2 ] ||
        echo 'Could not start InfiltratorOS graphical progress.' >&2
fi
/System/Commands/InfiltratorOS/ensure-native-fonts
publish_phase icons
/System/Commands/InfiltratorOS/ensure-native-icons
publish_phase host
/System/Commands/InfiltratorOS/select-theme configure
publish_phase releases

# Every run owns its own status and log directory beneath its temporary
# worker stage. No run may remove shared /Temporary/InfiltratorOS or files
# belonging to a previous or concurrent installation.
mkdir -p "$stage/status"
# The background supervisor inherits FD 9 and retains the provision lock
# while it waits for every child. Running the dispatcher synchronously here
# would deadlock against the APT/dpkg transaction that invoked postinst.
# No temporary runtime may be removed until all supervised workers have exited.
(
    # The background monitor, not the parent's bootstrap handler, now owns
    # the final status, with its independent lock and run directory.
    trap - 0
    trap '' HUP INT TERM
    status_root="$stage/status"
    touch "$stage/supervisor-started"
    # Dispatch and supervise outside the maintainer-script transaction.
    if ! INFILTRATOROS_INSTALL_RUNTIME="$stage" "$stage/orchestrate-native-install" "$stage" >"$stage/dispatcher.log" 2>&1; then
        printf '%s\n' 'Native dispatcher failed; see dispatcher.log.' > "$stage/FAILED"
        publish_summary failed
        exit 0
    fi
    # The dispatcher has reaped every worker. Missing or malformed terminal
    # records now mean failure, never a reason to wait indefinitely.
    outcome=$("$stage/system-monitor-progress" --run-status "$status_root") || outcome=running
    # Retain five recent failed, fully supervised runs. Never prune legacy or
    # unresolved stages: a FAILED marker alone does not prove process exit.
    touch "$stage/SUPERVISOR_REAPED"
    if [ "$outcome" = complete ]; then publish_phase finalising; fi
    prune_failed_runs() (
        kept=0
        find "$STATUS_ROOT" -maxdepth 1 -type d -name 'native-worker.*' -printf '%T@ %p\n' |
            sort -nr | while read -r stamp old; do
                [ "$old" != "$stage" ] || continue
                [ -f "$old/FAILED" ] && [ -f "$old/SUPERVISOR_REAPED" ] || continue
                kept=$((kept + 1))
                [ "$kept" -lt 5 ] || rm -rf -- "$old"
            done
    )
    prune_failed_runs || :
    case "$outcome" in
            complete)
                # Keep diagnostic logs, including build timings, after success.
                # Do not keep temporary source trees or executed native RUNs.
                archive_tmp="$STATUS_ROOT/.last-provision-logs.$$.tar.gz"
                if (umask 077
                    cd "$stage"
                    tar -czf "$archive_tmp" status selected.list phase \
                        native-release-preparation.log \
                        optional-filesystem-discovery.log dispatcher.log \
                        filesystems-optional.list filesystems-pending.list
                ); then
                    chmod 0600 "$archive_tmp"
                    mv -f -- "$archive_tmp" "$STATUS_ROOT/last-provision-logs.tar.gz"
                else
                    rm -f -- "$archive_tmp"
                fi
                publish_summary complete
                rm -rf -- "$stage"
                exit 0
                ;;
            *)
                printf '%s\n' 'Installation failed or a worker omitted its terminal status; this run retains its logs.' > "$stage/FAILED"
                publish_summary failed
                exit 0
                ;;
    esac
) </dev/null >/dev/null 2>&1 &

# Disable the bootstrap handler only after spawning the terminal monitor.
trap - 0
exit 0
